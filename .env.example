# Multi-Agent Email Automation + Evals — env template
#
# Copy to .env (loaded by docker-compose and src/db.py).
# NOTE: src/db.py reads POSTGRES_* + POSTGRES_OWNER_* + POSTGRES_EVALUATOR_*
#       so this file keeps both namesets aligned.

# --- Postgres container (matches docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bytemart

# Single superuser creds for the container's bootstrap (POSTGRES_USER/POSTGRES_PASSWORD in compose)
POSTGRES_USER=bytemart_owner
POSTGRES_PASSWORD=bytemart_owner_pw

# --- Two roles used by src/db.py ---
POSTGRES_OWNER_USER=bytemart_owner
POSTGRES_OWNER_PASSWORD=bytemart_owner_pw
POSTGRES_EVALUATOR_USER=bytemart_evaluator
POSTGRES_EVALUATOR_PASSWORD=bytemart_evaluator_pw

# --- OpenAI (generation + embeddings) ---
OPENAI_API_KEY=
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENAI_MODEL_EMBEDDING=text-embedding-3-small

# --- Judge (LLM-as-judge for the offline eval pipeline) ---
# When ALL THREE of JUDGE_BASE_URL + JUDGE_MODEL + JUDGE_API_KEY are set,
# the judge layer is enabled. Otherwise judge metrics are recorded as
# 'unscored' (never failed) and the test suite stays green.
#
# This project uses minimax as the judge (powered by minimax).

# --- minimax via OpenRouter (default for this project) ---
# Routes to the M3 model on https://openrouter.ai. OpenAI-compatible.
JUDGE_BASE_URL=https://openrouter.ai/api/v1
JUDGE_MODEL=minimax/minimax-m3:free
JUDGE_API_KEY=
# Free models cost $0.00; paid models use OpenRouter's published rates.
# Override the bundled defaults with:
# JUDGE_PRICING_IN=0.000000
# JUDGE_PRICING_OUT=0.000000

# --- minimax direct API (alternative) ---
# JUDGE_BASE_URL=https://api.minimaxi.com/v1
# JUDGE_MODEL=MiniMax-Text-01
# JUDGE_API_KEY=

# --- OpenAI (alternative) ---
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_MODEL=gpt-4o-mini
# JUDGE_API_KEY=

# --- Anthropic (alternative) ---
# JUDGE_BASE_URL=https://api.anthropic.com/v1
# JUDGE_MODEL=claude-3-5-haiku-latest
# JUDGE_API_KEY=

# --- Local vLLM (alternative) ---
# JUDGE_BASE_URL=http://localhost:8000/v1
# JUDGE_MODEL=Qwen2.5-7B-Instruct
# JUDGE_API_KEY=sk-no-key-needed

# --- RAG knobs (Phase 4B) ---
RAG_PARENT_TOKENS=1200
RAG_CHILD_TOKENS=300
RAG_CHILD_OVERLAP_TOKENS=50
RAG_TOP_K=3

# --- Misc ---
LOG_LEVEL=INFO
